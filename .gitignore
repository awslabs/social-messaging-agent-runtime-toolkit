# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# uv / pip
.venv/
venv/
.python-version
# uv.lock is committed: CI resolves with --frozen so every run and every
# contributor gets the same dependency set.

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checkers
.mypy_cache/
.pyright/
.ruff_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Node.js (admin console)
node_modules/
socialagent-admin-console/.vite/

# Copies of the runtime that projects scaffolded by an older CLI carry
# (`socialagent runtime update` removes them)
projects/*/socialagent_runtime/

# Generated agent projects (per-deployment, not part of this repository)
projects/

# ASH security scan output (config .ash.yaml IS committed; reports are not)
.ash/

# Local planning notes
.planning/

# Claude Code workspace state (scheduled_tasks.json, local settings) — per-developer, local only
.claude/

# AWS / Terraform
.terraform/
# Throwaway TF_DATA_DIR used by `make tf-validate` so it never touches .terraform/
.terraform-validate/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
# Terraform backend configs hold account-specific state bucket names
backend-*.hcl
!backend-*.hcl.example
.terraform.lock.hcl
.bedrock_agentcore.yaml

# Secrets & credentials
.env
.env.*
*.pem
*.key

# Logs
*.log
# Anchored to repo root so it only ignores a top-level runtime log dir — a bare
# "logs/" also silently swallowed source dirs like socialagent-admin-console/src/pages/logs/.
/logs/

# Build artifacts
*.zip
*.tar.gz

# Rendered documents
*.pdf

# Third-party brand marks used while editing the architecture diagram.
# docs/assets/architecture.drawio embeds the ones it draws as data URIs, so these
# standalone files are only a local convenience for re-editing; tracking them
# would leave a second copy that can silently drift from the embedded one.
docs/assets/icons/

# Example files hold placeholders only and must stay tracked even when a file
# pattern above matches them (`.env.*` matches socialagent-admin-console/.env.local.example).
# Last, so it overrides those patterns; files inside an ignored directory stay ignored.
!*.example
